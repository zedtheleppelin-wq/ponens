rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ein Dokument pro Spiel. Alle angemeldeten (auch anonymen) Spieler dürfen lesen und schreiben.
    match /games/{code} {
      allow read, write: if request.auth != null;

      // Warteraum: Jede Person trägt nur sich selbst ein oder aus.
      match /joins/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Live-Anzeige des laufenden Zugs.
      match /live/{doc} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
